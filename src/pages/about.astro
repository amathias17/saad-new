---
import BaseLayout from "../layouts/BaseLayout.astro";
import navData from '../data/navData.json';
import Footer from "../components/Footer.astro";

const { logoText, links, cta } = navData;
---

<BaseLayout
  title="About Dr. Saad - Expert Endodontist"
  description="Meet Dr. Saad, a dedicated endodontist specializing in root canal therapy and advanced endodontic care. Learn about our practice and commitment to exceptional patient care."
  showNavbar={false}
  mainClass="no-main-padding"
>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="logo">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 8C13.373 8 8 13.373 8 20C8 23.866 10.686 27.066 14.343 28.343C14.686 27.237 15 25.866 15 24.5C15 22.567 16.567 21 18.5 21H21.5C23.433 21 25 22.567 25 24.5C25 25.866 25.314 27.237 25.657 28.343C29.314 27.066 32 23.866 32 20C32 13.373 26.627 8 20 8Z" fill="currentColor"/>
        </svg>
        <span class="logo-text">{logoText}</span>
      </div>

      <ul class="nav-links">
        {links.map((link) => (
          <li class={`nav-item${link.children?.length ? ' has-dropdown' : ''}`}>
            <a class="nav-link" href={link.href}>
              {link.label}
              {link.children?.length ? <span class="nav-caret" aria-hidden="true">v</span> : null}
            </a>
            {link.children?.length ? (
              <div class="nav-dropdown" role="menu" aria-label={`${link.label} submenu`}>
                {link.children.map((child) => (
                  <a class="nav-dropdown-link" href={child.href}>{child.label}</a>
                ))}
              </div>
            ) : null}
          </li>
        ))}
      </ul>

      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
        {links.map((link) => (
          link.children?.length ? (
            <div class="mobile-nav-group">
              <a class="mobile-nav-parent" href={link.href}>{link.label}</a>
              {link.children.map((child) => (
                <a class="mobile-nav-child" href={child.href}>{child.label}</a>
              ))}
            </div>
          ) : (
            <a href={link.href}>{link.label}</a>
          )
        ))}
        <a class="mobile-cta" href={cta.href}>{cta.label}</a>
      </div>

      <a class="cta-button" href={cta.href}>{cta.label}</a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="about-hero">
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          Meet Your Endodontist
        </div>

        <h1 class="hero-title">
          Preserving Smiles Through<br/>
          <span class="gradient-text">Expert Endodontic Care</span>
        </h1>

        <p class="hero-description">
          Dr. Saad combines years of specialized training with cutting-edge technology
          to provide gentle, effective root canal treatments that save teeth and restore comfort.
        </p>
      </div>

      <div class="hero-visual">
        <div class="portrait-frame">
          <div class="portrait-placeholder">
            <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="400" height="500" rx="24" fill="url(#portrait-gradient)"/>
              <circle cx="200" cy="200" r="80" fill="white" opacity="0.15"/>
              <circle cx="200" cy="200" r="60" fill="white" opacity="0.1"/>
              <path d="M170 180C175 175 185 172 200 172C215 172 225 175 230 180M170 200C170 200 180 195 200 195C220 195 230 200 230 200" stroke="white" stroke-width="3" stroke-linecap="round" opacity="0.3"/>
              <defs>
                <linearGradient id="portrait-gradient" x1="0" y1="0" x2="400" y2="500">
                  <stop offset="0%" stop-color="var(--sage-dark)"/>
                  <stop offset="100%" stop-color="var(--deep-green)"/>
                </linearGradient>
              </defs>
            </svg>
            <div class="portrait-label">Dr. Saad, DDS</div>
          </div>
        </div>

        <div class="credential-float float-1">
          <div class="float-icon">🎓</div>
          <div class="float-text">
            <div class="float-title">Board Certified</div>
            <div class="float-subtitle">Endodontist</div>
          </div>
        </div>

        <div class="credential-float float-2">
          <div class="float-icon">⭐</div>
          <div class="float-text">
            <div class="float-title">15+ Years</div>
            <div class="float-subtitle">Experience</div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-bg-blob"></div>
  </section>

  <!-- Story Section -->
  <section class="story-section">
    <div class="story-container">
      <div class="story-content">
        <div class="section-badge">Our Story</div>
        <h2 class="section-title">
          A Journey Rooted in<br/>
          <span class="gradient-text">Compassionate Care</span>
        </h2>

        <div class="story-text">
          <p>
            Dr. Saad's journey into endodontics began with a simple but powerful belief:
            every tooth saved is a smile preserved. After completing dental school with honors,
            Dr. Saad pursued specialized training in endodontics, driven by a passion for
            combining technical precision with genuine patient care.
          </p>

          <p>
            What sets our practice apart is our unwavering commitment to staying at the
            forefront of endodontic innovation. From advanced microscopy to cutting-edge
            3D imaging, we invest in technology that makes treatments more precise,
            comfortable, and successful.
          </p>

          <p>
            But technology is only part of the story. We believe that exceptional endodontic
            care begins with listening. Every patient receives personalized attention, clear
            communication, and treatment plans tailored to their unique needs and concerns.
          </p>
        </div>
      </div>

      <div class="story-stats">
        <div class="stat-card">
          <div class="stat-visual">
            <svg viewBox="0 0 100 100" fill="none">
              <circle cx="50" cy="50" r="45" stroke="var(--sage)" stroke-width="8" opacity="0.2"/>
              <circle cx="50" cy="50" r="45" stroke="url(#stat-gradient-1)" stroke-width="8" stroke-dasharray="283" stroke-dashoffset="28" stroke-linecap="round" transform="rotate(-90 50 50)"/>
              <text x="50" y="50" text-anchor="middle" dy="0.35em" font-family="Plus Jakarta Sans" font-size="24" font-weight="800" fill="var(--sage-dark)">98%</text>
              <defs>
                <linearGradient id="stat-gradient-1" x1="0" y1="0" x2="100" y2="100">
                  <stop offset="0%" stop-color="var(--sage)"/>
                  <stop offset="100%" stop-color="var(--terracotta)"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <h3 class="stat-title">Success Rate</h3>
          <p class="stat-description">Advanced techniques ensure optimal outcomes</p>
        </div>

        <div class="stat-card">
          <div class="stat-visual">
            <svg viewBox="0 0 100 100" fill="none">
              <circle cx="50" cy="50" r="45" stroke="var(--sage)" stroke-width="8" opacity="0.2"/>
              <circle cx="50" cy="50" r="45" stroke="url(#stat-gradient-2)" stroke-width="8" stroke-dasharray="283" stroke-dashoffset="56" stroke-linecap="round" transform="rotate(-90 50 50)"/>
              <text x="50" y="50" text-anchor="middle" dy="0.35em" font-family="Plus Jakarta Sans" font-size="20" font-weight="800" fill="var(--sage-dark)">5000+</text>
              <defs>
                <linearGradient id="stat-gradient-2" x1="0" y1="0" x2="100" y2="100">
                  <stop offset="0%" stop-color="var(--terracotta)"/>
                  <stop offset="100%" stop-color="var(--sage)"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <h3 class="stat-title">Procedures Completed</h3>
          <p class="stat-description">Extensive experience you can trust</p>
        </div>

        <div class="stat-card">
          <div class="stat-visual">
            <svg viewBox="0 0 100 100" fill="none">
              <circle cx="50" cy="50" r="45" stroke="var(--sage)" stroke-width="8" opacity="0.2"/>
              <circle cx="50" cy="50" r="45" stroke="url(#stat-gradient-3)" stroke-width="8" stroke-dasharray="283" stroke-dashoffset="42" stroke-linecap="round" transform="rotate(-90 50 50)"/>
              <text x="50" y="50" text-anchor="middle" dy="0.35em" font-family="Plus Jakarta Sans" font-size="24" font-weight="800" fill="var(--sage-dark)">4.9</text>
              <defs>
                <linearGradient id="stat-gradient-3" x1="0" y1="0" x2="100" y2="100">
                  <stop offset="0%" stop-color="var(--sage-dark)"/>
                  <stop offset="100%" stop-color="var(--terracotta)"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <h3 class="stat-title">Patient Rating</h3>
          <p class="stat-description">Consistently exceptional care</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise Section -->
  <section class="expertise-section">
    <div class="expertise-container">
      <div class="section-header">
        <div class="section-badge">Specialized Expertise</div>
        <h2 class="section-title">
          Advanced Training in<br/>
          <span class="gradient-text">Endodontic Excellence</span>
        </h2>
        <p class="section-description">
          Continuous education and specialized certifications ensure you receive
          the most advanced care available.
        </p>
      </div>

      <div class="expertise-grid">
        <div class="expertise-card">
          <div class="card-icon">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
              <path d="M32 16L36 28L48 28L38 36L42 48L32 40L22 48L26 36L16 28L28 28L32 16Z" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="card-title">Root Canal Therapy</h3>
          <p class="card-description">
            Utilizing advanced microscopy and digital imaging for precise,
            comfortable treatment of infected or damaged teeth.
          </p>
        </div>

        <div class="expertise-card">
          <div class="card-icon">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
              <rect x="24" y="20" width="16" height="24" rx="2" fill="currentColor"/>
              <path d="M28 32L30 34L36 28" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title">Endodontic Surgery</h3>
          <p class="card-description">
            Apicoectomy and root-end procedures performed with surgical precision
            to save teeth that cannot be treated conventionally.
          </p>
        </div>

        <div class="expertise-card">
          <div class="card-icon">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
              <path d="M24 28C24 28 28 20 32 20C36 20 40 28 40 28V38C40 42 36 44 32 44C28 44 24 42 24 38V28Z" fill="currentColor"/>
              <circle cx="28" cy="30" r="2" fill="white"/>
              <circle cx="36" cy="30" r="2" fill="white"/>
            </svg>
          </div>
          <h3 class="card-title">Traumatic Injuries</h3>
          <p class="card-description">
            Emergency care for dental trauma, including tooth fractures,
            avulsions, and other urgent endodontic needs.
          </p>
        </div>

        <div class="expertise-card">
          <div class="card-icon">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
              <circle cx="32" cy="32" r="16" stroke="currentColor" stroke-width="3" fill="none"/>
              <circle cx="32" cy="32" r="4" fill="currentColor"/>
              <line x1="32" y1="20" x2="32" y2="26" stroke="currentColor" stroke-width="2"/>
              <line x1="32" y1="38" x2="32" y2="44" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <h3 class="card-title">Retreatment</h3>
          <p class="card-description">
            When previous root canal treatment hasn't resolved the issue,
            specialized retreatment can often save the tooth.
          </p>
        </div>

        <div class="expertise-card">
          <div class="card-icon">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
              <path d="M32 18C24 18 18 24 18 32C18 37 22 42 27 44C27.5 42.5 28 40.5 28 38.5C28 36 30 34 32.5 34H33.5C36 34 38 36 38 38.5C38 40.5 38.5 42.5 39 44C44 42 48 37 48 32C48 24 42 18 32 18Z" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="card-title">Cracked Teeth</h3>
          <p class="card-description">
            Diagnosis and treatment of complex tooth fractures using advanced
            imaging and specialized techniques.
          </p>
        </div>

        <div class="expertise-card">
          <div class="card-icon">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
              <rect x="20" y="24" width="24" height="20" rx="3" fill="currentColor"/>
              <path d="M28 32L30 34L36 28" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="card-title">Pain Management</h3>
          <p class="card-description">
            Comprehensive diagnosis and treatment of dental pain, ensuring
            patient comfort throughout every procedure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="philosophy-section">
    <div class="philosophy-container">
      <div class="philosophy-visual">
        <div class="philosophy-card">
          <div class="card-decoration"></div>
          <h3 class="card-heading">Our Philosophy</h3>
          <div class="philosophy-points">
            <div class="point">
              <div class="point-icon">💙</div>
              <div class="point-content">
                <h4>Patient-Centered Care</h4>
                <p>Your comfort and understanding come first in every decision we make.</p>
              </div>
            </div>

            <div class="point">
              <div class="point-icon">🔬</div>
              <div class="point-content">
                <h4>Evidence-Based Treatment</h4>
                <p>We use proven techniques backed by the latest endodontic research.</p>
              </div>
            </div>

            <div class="point">
              <div class="point-icon">✨</div>
              <div class="point-content">
                <h4>Gentle Precision</h4>
                <p>Advanced technology meets compassionate care for optimal outcomes.</p>
              </div>
            </div>

            <div class="point">
              <div class="point-icon">🤝</div>
              <div class="point-content">
                <h4>Collaborative Approach</h4>
                <p>We work closely with your general dentist to ensure comprehensive care.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="philosophy-content">
        <div class="section-badge">Our Approach</div>
        <h2 class="section-title">
          Care That Goes<br/>
          <span class="gradient-text">Beyond Treatment</span>
        </h2>

        <div class="philosophy-text">
          <p>
            At our practice, we understand that endodontic treatment can feel daunting.
            That's why we've created an environment where patients feel heard, understood,
            and genuinely cared for.
          </p>

          <p>
            We take the time to explain every aspect of your treatment in plain language,
            answer all your questions, and ensure you're comfortable every step of the way.
            Our goal isn't just to treat teeth—it's to build lasting relationships based on
            trust, transparency, and exceptional outcomes.
          </p>

          <p>
            From your first consultation through follow-up care, you'll experience the
            difference that specialized expertise and genuine compassion can make.
          </p>
        </div>

        <div class="philosophy-cta">
          <button class="cta-button primary">
            Schedule a Consultation
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Practice Section -->
  <section class="practice-section">
    <div class="practice-container">
      <div class="section-header">
        <div class="section-badge">Our Practice</div>
        <h2 class="section-title">
          A Space Designed for<br/>
          <span class="gradient-text">Comfort & Healing</span>
        </h2>
      </div>

      <div class="practice-features">
        <div class="feature-row">
          <div class="feature-item">
            <div class="feature-visual">
              <svg viewBox="0 0 80 80" fill="none">
                <circle cx="40" cy="40" r="35" fill="url(#feature-gradient-1)" opacity="0.15"/>
                <path d="M30 40L36 46L50 32" stroke="var(--sage-dark)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="feature-gradient-1" x1="0" y1="0" x2="80" y2="80">
                    <stop offset="0%" stop-color="var(--sage)"/>
                    <stop offset="100%" stop-color="var(--terracotta)"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <h3>State-of-the-Art Technology</h3>
            <p>Operating microscopes, 3D imaging, and digital radiography for precise diagnosis and treatment</p>
          </div>

          <div class="feature-item">
            <div class="feature-visual">
              <svg viewBox="0 0 80 80" fill="none">
                <circle cx="40" cy="40" r="35" fill="url(#feature-gradient-2)" opacity="0.15"/>
                <circle cx="40" cy="35" r="12" stroke="var(--sage-dark)" stroke-width="3" fill="none"/>
                <path d="M30 52C30 52 32 48 40 48C48 48 50 52 50 52" stroke="var(--sage-dark)" stroke-width="3" stroke-linecap="round"/>
                <defs>
                  <linearGradient id="feature-gradient-2" x1="0" y1="0" x2="80" y2="80">
                    <stop offset="0%" stop-color="var(--terracotta)"/>
                    <stop offset="100%" stop-color="var(--sage)"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <h3>Comfort-Focused Environment</h3>
            <p>Relaxing atmosphere with amenities designed to reduce anxiety and enhance your experience</p>
          </div>
        </div>

        <div class="feature-row">
          <div class="feature-item">
            <div class="feature-visual">
              <svg viewBox="0 0 80 80" fill="none">
                <circle cx="40" cy="40" r="35" fill="url(#feature-gradient-3)" opacity="0.15"/>
                <rect x="28" y="28" width="24" height="24" rx="4" stroke="var(--sage-dark)" stroke-width="3" fill="none"/>
                <path d="M34 40L38 44L46 36" stroke="var(--sage-dark)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="feature-gradient-3" x1="0" y1="0" x2="80" y2="80">
                    <stop offset="0%" stop-color="var(--sage-dark)"/>
                    <stop offset="100%" stop-color="var(--sage)"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <h3>Flexible Scheduling</h3>
            <p>Convenient appointment times, including emergency slots for urgent care needs</p>
          </div>

          <div class="feature-item">
            <div class="feature-visual">
              <svg viewBox="0 0 80 80" fill="none">
                <circle cx="40" cy="40" r="35" fill="url(#feature-gradient-4)" opacity="0.15"/>
                <path d="M40 20C31 20 24 27 24 36C24 42 28 47 34 49.5M40 20C49 20 56 27 56 36C56 42 52 47 46 49.5M40 20V36M34 49.5C36 51 38 52 40 52C42 52 44 51 46 49.5M34 49.5L40 36L46 49.5" stroke="var(--sage-dark)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="feature-gradient-4" x1="0" y1="0" x2="80" y2="80">
                    <stop offset="0%" stop-color="var(--terracotta)"/>
                    <stop offset="100%" stop-color="var(--sage-dark)"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <h3>Comprehensive Care Coordination</h3>
            <p>Seamless collaboration with your general dentist for integrated treatment planning</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Navbar Styles */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(250, 249, 246, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(168, 197, 181, 0.1);
    box-shadow: 0 6px 18px rgba(42, 95, 79, 0.08);
    animation: slideDown 0.6s ease-out;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--sage-dark);
    transition: transform 0.3s ease;
  }

  .logo:hover {
    transform: scale(1.05);
  }

  .logo svg {
    animation: fadeIn 0.8s ease-out 0.2s both;
  }

  .logo-text {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    animation: fadeIn 0.8s ease-out 0.3s both;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    animation: fadeIn 0.8s ease-out 0.4s both;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--sage);
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: var(--sage-dark);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-caret {
    font-size: 0.7rem;
    color: var(--sage-dark);
    transition: transform 0.3s ease;
  }

  .nav-item:hover .nav-caret,
  .nav-item:focus-within .nav-caret {
    transform: translateY(1px);
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: -0.75rem;
    background: rgba(250, 249, 246, 0.98);
    border: 1px solid rgba(168, 197, 181, 0.2);
    border-radius: 16px;
    padding: 0.75rem;
    min-width: 200px;
    box-shadow: 0 18px 32px rgba(42, 95, 79, 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 5;
  }

  .nav-item:hover .nav-dropdown,
  .nav-item:focus-within .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-dropdown-link {
    display: block;
    padding: 0.55rem 0.85rem;
    border-radius: 12px;
