---
import BaseLayout from "../layouts/BaseLayout.astro";
import DentistHero from "../components/DentistHero.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Testimonials from "../components/Testimonials.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
	title="Serenity Dental - Gentle, Modern Dental Care"
	description="Experience dental care that feels different. We combine gentle expertise with modern technology to make every visit comfortable and stress-free."
	showNavbar={false}
	mainClass="no-main-padding"
>
	<DentistHero />
	<Services />
	<About />
	<Testimonials />
	<CTA />
	<Footer />
</BaseLayout>
