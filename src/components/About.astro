---
// About Section Component
---

<section class="about" id="about">
  <div class="about-container">
    <div class="about-content">
      <div class="section-badge">About Us</div>
      <h2 class="section-title">
        Caring for Smiles<br/>
        <span class="gradient-text">Since 2008</span>
      </h2>
      <p class="about-text">
        At Serenity Dental, we believe that going to the dentist shouldn't be stressful.
        Our practice was founded on the principle that quality dental care should be
        delivered with genuine compassion and attention to each patient's unique needs.
      </p>
      <p class="about-text">
        We've invested in the latest technology and continuing education to ensure
        you receive the most advanced care available—all delivered in a warm,
        spa-like environment designed to help you relax.
      </p>

      <div class="credentials">
        <div class="credential-item">
          <div class="credential-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="20" fill="currentColor" opacity="0.1"/>
              <path d="M24 12L27 21L36 21L29 26L32 35L24 30L16 35L19 26L12 21L21 21L24 12Z" fill="currentColor"/>
            </svg>
          </div>
          <div class="credential-text">
            <div class="credential-title">Award Winning</div>
            <div class="credential-subtitle">Best Dental Practice 2023</div>
          </div>
        </div>

        <div class="credential-item">
          <div class="credential-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="20" fill="currentColor" opacity="0.1"/>
              <rect x="16" y="18" width="16" height="16" rx="2" fill="currentColor"/>
              <path d="M20 26L22 28L28 22" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="credential-text">
            <div class="credential-title">Board Certified</div>
            <div class="credential-subtitle">ADA Accredited Professionals</div>
          </div>
        </div>

        <div class="credential-item">
          <div class="credential-icon">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="20" fill="currentColor" opacity="0.1"/>
              <path d="M24 16C19 16 15 20 15 25C15 30 19 34 24 34C29 34 33 30 33 25C33 20 29 16 24 16Z" fill="currentColor"/>
              <circle cx="21" cy="23" r="1.5" fill="white"/>
              <circle cx="27" cy="23" r="1.5" fill="white"/>
              <path d="M21 27C21 27 22 29 24 29C26 29 27 27 27 27" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="credential-text">
            <div class="credential-title">Patient Focused</div>
            <div class="credential-subtitle">10,000+ Happy Patients</div>
          </div>
        </div>
      </div>
    </div>

    <div class="about-visual">
      <div class="image-placeholder">
        <div class="placeholder-content">
          <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Decorative background -->
            <rect width="400" height="500" rx="24" fill="url(#about-gradient)"/>

            <!-- Abstract dental-themed illustration -->
            <circle cx="200" cy="250" r="120" fill="white" opacity="0.1"/>
            <circle cx="200" cy="250" r="80" fill="white" opacity="0.2"/>

            <path d="M150 220C150 220 165 180 200 180C235 180 250 220 250 220" stroke="white" stroke-width="4" stroke-linecap="round" opacity="0.4"/>
            <path d="M150 280C150 280 165 320 200 320C235 320 250 280 250 280" stroke="white" stroke-width="4" stroke-linecap="round" opacity="0.4"/>

            <defs>
              <linearGradient id="about-gradient" x1="0" y1="0" x2="400" y2="500">
                <stop offset="0%" stop-color="var(--sage)"/>
                <stop offset="100%" stop-color="var(--sage-dark)"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="placeholder-text">Modern Dental Office</div>
        </div>
      </div>

      <!-- Floating stats -->
      <div class="floating-stat stat-1">
        <div class="stat-number">15+</div>
        <div class="stat-label">Years Experience</div>
      </div>

      <div class="floating-stat stat-2">
        <div class="stat-number">98%</div>
        <div class="stat-label">Satisfaction Rate</div>
      </div>
    </div>
  </div>

  <!-- Background decoration -->
  <div class="about-bg-circle"></div>
</section>

<style>
  .about {
    padding: 8rem 2rem;
    background: var(--ivory);
    position: relative;
    overflow: hidden;
  }

  .about-bg-circle {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168, 197, 181, 0.08) 0%, transparent 70%);
    top: 50%;
    right: -200px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .about-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .about-content {
    animation: fadeInUp 0.8s ease-out;
  }

  .section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--sage) 0%, var(--terracotta) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-text {
    font-family: 'Manrope', sans-serif;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .credentials {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .credential-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    background: white;
    border-radius: 16px;
    border: 1px solid rgba(168, 197, 181, 0.15);
    transition: all 0.3s ease;
  }

  .credential-item:hover {
    transform: translateX(8px);
    box-shadow: 0 8px 30px rgba(42, 95, 79, 0.1);
    border-color: var(--sage);
  }

  .credential-icon {
    width: 48px;
    height: 48px;
    color: var(--sage-dark);
    flex-shrink: 0;
  }

  .credential-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .credential-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .credential-subtitle {
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .about-visual {
    position: relative;
    animation: fadeIn 1s ease-out 0.3s both;
  }

  .image-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(42, 95, 79, 0.2);
    position: relative;
  }

  .placeholder-content {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .placeholder-content svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-text {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    color: white;
    font-family: 'Manrope', sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    background: rgba(42, 95, 79, 0.8);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    backdrop-filter: blur(10px);
  }

  .floating-stat {
    position: absolute;
    background: white;
    padding: 1.5rem 2rem;
    border-radius: 20px;
    box-shadow: 0 12px 40px rgba(42, 95, 79, 0.15);
    border: 1px solid rgba(168, 197, 181, 0.2);
  }

  .stat-1 {
    top: 10%;
    right: -10%;
    animation: float 4s ease-in-out infinite;
  }

  .stat-2 {
    bottom: 15%;
    left: -10%;
    animation: float 5s ease-in-out infinite 1s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .stat-number {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--sage-dark);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1024px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .about-visual {
      order: -1;
    }

    .floating-stat {
      position: static;
      display: inline-block;
      margin: 1rem 1rem 0 0;
    }
  }

  @media (max-width: 768px) {
    .about {
      padding: 5rem 1.5rem;
    }

    .section-title {
      font-size: 2.5rem;
    }

    .about-text {
      font-size: 1rem;
    }

    .credentials {
      gap: 1rem;
    }

    .credential-item {
      padding: 1rem;
    }
  }
</style>
