<style>
  .testimonials {
    padding: 8rem 2rem;
    background: var(--warm-gray);
    position: relative;
  }

  .testimonials-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 5rem;
    animation: fadeInUp 0.8s ease-out;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .testimonial-card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid rgba(168, 197, 181, 0.15);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .testimonial-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(42, 95, 79, 0.15);
    border-color: var(--sage);
  }

  .testimonial-card.featured {
    background: linear-gradient(135deg, #f8f9f8 0%, white 100%);
    border: 2px solid var(--sage);
    box-shadow: 0 20px 60px rgba(42, 95, 79, 0.12);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sage-dark);
    color: white;
    padding: 0.4rem 1.25rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stars {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .star {
    width: 20px;
    height: 20px;
    color: var(--amber);
  }

  .testimonial-text {
    font-family: 'Manrope', sans-serif;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    flex-grow: 1;
    font-style: italic;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(168, 197, 181, 0.15);
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--sage) 0%, var(--terracotta) 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .author-treatment {
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .rating-summary {
    background: white;
    border-radius: 24px;
    padding: 3rem;
    border: 1px solid rgba(168, 197, 181, 0.15);
    box-shadow: 0 12px 40px rgba(42, 95, 79, 0.1);
  }

  .summary-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }

  .summary-score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .score-number {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--sage-dark) 0%, var(--terracotta) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .score-stars {
    display: flex;
    gap: 0.5rem;
  }

  .score-stars .star {
    width: 28px;
    height: 28px;
  }

  .summary-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .summary-count {
    font-family: 'Manrope', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .summary-platforms {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    color: var(--text-secondary);
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .testimonials {
      padding: 5rem 1.5rem;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .testimonial-card {
      padding: 2rem;
    }

    .rating-summary {
      padding: 2rem;
    }

    .summary-content {
      flex-direction: column;
      gap: 2rem;
    }

    .score-number {
      font-size: 3rem;
    }
  }
</style>
