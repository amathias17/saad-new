---
// Services Section Component
import SectionHeader from "./SectionHeader.astro";
---

<section class="services" id="services">
  <div class="services-container">
    <SectionHeader
      badge="Our Services"
      description="From routine checkups to advanced treatments, we offer everything you need to maintain a healthy, beautiful smile."
    >
      Comprehensive Dental Care
    </SectionHeader>

    <div class="services-grid">
      <div class="service-card">
        <div class="service-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
            <path d="M32 16C24.268 16 18 22.268 18 30C18 34.866 21.686 38.866 26.343 40.343C26.686 38.737 27 36.866 27 35C27 32.239 29.239 30 32 30C34.761 30 37 32.239 37 35C37 36.866 37.314 38.737 37.657 40.343C42.314 38.866 46 34.866 46 30C46 22.268 39.732 16 32 16Z" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="service-title">Preventive Care</h3>
        <p class="service-description">
          Regular cleanings, exams, and X-rays to keep your teeth healthy and catch issues early.
        </p>
        <ul class="service-list">
          <li>Professional Cleanings</li>
          <li>Comprehensive Exams</li>
          <li>Digital X-Rays</li>
          <li>Oral Cancer Screening</li>
        </ul>
      </div>

      <div class="service-card featured">
        <div class="featured-badge">Most Popular</div>
        <div class="service-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
            <path d="M32 18L35 28H45L37 34L40 44L32 38L24 44L27 34L19 28H29L32 18Z" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="service-title">Cosmetic Dentistry</h3>
        <p class="service-description">
          Transform your smile with our advanced cosmetic treatments and artistic expertise.
        </p>
        <ul class="service-list">
          <li>Teeth Whitening</li>
          <li>Porcelain Veneers</li>
          <li>Smile Makeovers</li>
          <li>Bonding & Contouring</li>
        </ul>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
            <rect x="22" y="26" width="20" height="16" rx="2" fill="currentColor"/>
            <circle cx="32" cy="34" r="3" fill="white"/>
          </svg>
        </div>
        <h3 class="service-title">Restorative Care</h3>
        <p class="service-description">
          Repair and restore damaged teeth with natural-looking, long-lasting solutions.
        </p>
        <ul class="service-list">
          <li>Dental Crowns</li>
          <li>Bridges & Implants</li>
          <li>Fillings</li>
          <li>Root Canal Therapy</li>
        </ul>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
            <path d="M28 24H36V40H28V24Z" fill="currentColor"/>
            <path d="M24 28H28V36H24V28Z" fill="currentColor"/>
            <path d="M36 28H40V36H36V28Z" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="service-title">Orthodontics</h3>
        <p class="service-description">
          Straighten your teeth with modern solutions, from traditional braces to clear aligners.
        </p>
        <ul class="service-list">
          <li>Clear Aligners</li>
          <li>Traditional Braces</li>
          <li>Retainers</li>
          <li>Orthodontic Consultations</li>
        </ul>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
            <path d="M32 20L26 32L32 38L38 32L32 20Z" fill="currentColor"/>
            <circle cx="32" cy="32" r="6" fill="white"/>
          </svg>
        </div>
        <h3 class="service-title">Emergency Care</h3>
        <p class="service-description">
          Immediate attention for dental emergencies. We're here when you need us most.
        </p>
        <ul class="service-list">
          <li>Same-Day Appointments</li>
          <li>Pain Relief</li>
          <li>Broken Tooth Repair</li>
          <li>24/7 Emergency Line</li>
        </ul>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="currentColor" opacity="0.1"/>
            <path d="M32 22C27 22 23 26 23 31C23 36 27 40 32 40C37 40 41 36 41 31C41 26 37 22 32 22Z" fill="currentColor"/>
            <circle cx="28" cy="29" r="2" fill="white"/>
            <circle cx="36" cy="29" r="2" fill="white"/>
            <path d="M28 34C28 34 30 36 32 36C34 36 36 34 36 34" stroke="white" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="service-title">Pediatric Dentistry</h3>
        <p class="service-description">
          Gentle, specialized care for children in a fun, friendly environment.
        </p>
        <ul class="service-list">
          <li>Children's Cleanings</li>
          <li>Fluoride Treatments</li>
          <li>Dental Sealants</li>
          <li>Early Orthodontic Assessment</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    padding: 8rem 2rem;
    background: linear-gradient(180deg, var(--ivory) 0%, var(--warm-gray) 100%);
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent 0%, rgba(168, 197, 181, 0.2) 50%, transparent 100%);
  }

  .services-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
  }

  .service-card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid rgba(168, 197, 181, 0.15);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sage) 0%, var(--terracotta) 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-card:hover::before {
    transform: scaleX(1);
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(42, 95, 79, 0.15);
    border-color: var(--sage);
  }

  .service-card.featured {
    background: linear-gradient(135deg, var(--sage-dark) 0%, var(--deep-green) 100%);
    color: white;
    border: none;
    box-shadow: 0 20px 60px rgba(42, 95, 79, 0.25);
  }

  .service-card.featured .service-title,
  .service-card.featured .service-description,
  .service-card.featured .service-list {
    color: white;
  }

  .service-card.featured .service-list li {
    color: rgba(255, 255, 255, 0.92);
  }

  .service-card.featured .service-list li::before {
    background: rgba(255, 255, 255, 0.3);
  }

  .featured-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: var(--terracotta);
    color: white;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .service-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 1.5rem;
    color: var(--sage-dark);
    transition: all 0.4s ease;
  }

  .service-card.featured .service-icon {
    color: white;
  }

  .service-card:hover .service-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .service-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .service-description {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .service-list {
    list-style: none;
    padding: 0;
  }

  .service-list li {
    padding: 0.6rem 0;
    padding-left: 1.5rem;
    position: relative;
    font-family: 'Manrope', sans-serif;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .service-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--sage);
    border-radius: 50%;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .services {
      padding: 5rem 1.5rem;
    }

    .section-title {
      font-size: 2.5rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .service-card {
      padding: 2rem;
    }
  }
</style>
