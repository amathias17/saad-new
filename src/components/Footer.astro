---
// Footer Component
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <div class="footer-logo">
          <svg width="48" height="48" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 8C13.373 8 8 13.373 8 20C8 23.866 10.686 27.066 14.343 28.343C14.686 27.237 15 25.866 15 24.5C15 22.567 16.567 21 18.5 21H21.5C23.433 21 25 22.567 25 24.5C25 25.866 25.314 27.237 25.657 28.343C29.314 27.066 32 23.866 32 20C32 13.373 26.627 8 20 8Z" fill="currentColor"/>
          </svg>
          <span class="footer-logo-text">Serenity Dental</span>
        </div>
        <p class="footer-tagline">
          Your partner in achieving and maintaining a healthy, beautiful smile.
          Experience dental care that feels different.
        </p>
        <div class="footer-social">
          <a href="#" class="social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-column">
          <h3 class="footer-heading">Services</h3>
          <ul class="footer-list">
            <li><a href="#services">Preventive Care</a></li>
            <li><a href="#services">Cosmetic Dentistry</a></li>
            <li><a href="#services">Restorative Care</a></li>
            <li><a href="#services">Orthodontics</a></li>
            <li><a href="#services">Emergency Care</a></li>
            <li><a href="#services">Pediatric Dentistry</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Company</h3>
          <ul class="footer-list">
            <li><a href="#about">About Us</a></li>
            <li><a href="#team">Our Team</a></li>
            <li><a href="#testimonials">Testimonials</a></li>
            <li><a href="#blog">Blog</a></li>
            <li><a href="#careers">Careers</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Resources</h3>
          <ul class="footer-list">
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#insurance">Insurance & Billing</a></li>
            <li><a href="#forms">Patient Forms</a></li>
            <li><a href="#covid">COVID-19 Update</a></li>
            <li><a href="#privacy">Privacy Policy</a></li>
            <li><a href="#terms">Terms of Service</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h3 class="footer-heading">Contact Us</h3>
          <ul class="footer-contact">
            <li class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>123 Dental Street<br/>Suite 100<br/>City, ST 12345</span>
            </li>
            <li class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
              <a href="tel:+15551234567">(555) 123-4567</a>
            </li>
            <li class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <a href="mailto:hello@serenitydental.com">hello@serenitydental.com</a>
            </li>
          </ul>

          <div class="office-hours">
            <h4 class="hours-heading">Office Hours</h4>
            <div class="hours-list">
              <div class="hours-item">
                <span>Mon - Fri</span>
                <span>8:00 AM - 6:00 PM</span>
              </div>
              <div class="hours-item">
                <span>Saturday</span>
                <span>9:00 AM - 3:00 PM</span>
              </div>
              <div class="hours-item">
                <span>Sunday</span>
                <span>Closed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <p class="copyright">
          © 2024 Serenity Dental. All rights reserved.
        </p>
        <div class="footer-bottom-links">
          <a href="#privacy">Privacy Policy</a>
          <span class="divider">•</span>
          <a href="#terms">Terms of Service</a>
          <span class="divider">•</span>
          <a href="#accessibility">Accessibility</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative wave -->
  <div class="footer-wave">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,58.7C960,64,1056,64,1152,58.7C1248,53,1344,43,1392,37.3L1440,32L1440,0L1392,0C1344,0,1248,0,1152,0C1056,0,960,0,864,0C768,0,672,0,576,0C480,0,384,0,288,0C192,0,96,0,48,0L0,0Z" fill="var(--sage-dark)" opacity="0.1"/>
    </svg>
  </div>
</footer>

<style>
  .footer {
    background: var(--text-primary);
    color: rgba(255, 255, 255, 0.8);
    position: relative;
    overflow: hidden;
  }

  .footer-wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 120px;
    transform: translateY(-100%);
  }

  .footer-wave svg {
    width: 100%;
    height: 100%;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 5rem 2rem 2rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 2rem;
  }

  .footer-brand {
    animation: fadeInUp 0.8s ease-out;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    color: white;
  }

  .footer-logo svg {
    width: 48px;
    height: 48px;
  }

  .footer-logo-text {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 400px;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: white;
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .social-link:hover {
    background: var(--sage);
    transform: translateY(-3px);
    border-color: var(--sage);
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }

  .footer-column {
    animation: fadeInUp 0.8s ease-out;
  }

  .footer-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.5rem;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-list li {
    margin-bottom: 0.75rem;
  }

  .footer-list a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .footer-list a:hover {
    color: var(--sage);
    transform: translateX(4px);
  }

  .footer-contact {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .contact-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--sage);
    margin-top: 2px;
  }

  .contact-item a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-item a:hover {
    color: var(--sage);
  }

  .office-hours {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hours-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hours-item {
    display: flex;
    justify-content: space-between;
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-bottom {
    animation: fadeIn 1s ease-out 0.3s both;
  }

  .footer-bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
  }

  .footer-bottom-links a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-bottom-links a:hover {
    color: var(--sage);
  }

  .divider {
    color: rgba(255, 255, 255, 0.3);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1024px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      padding: 4rem 1.5rem 2rem;
    }

    .footer-links {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
    }

    .footer-tagline {
      max-width: 100%;
    }
  }
</style>
