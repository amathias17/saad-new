<script>
  // Mobile menu toggle
  const navigation = document.querySelector('#am-navigation');
  const toggle = document.querySelector('.am-toggle');
  const menu = document.querySelector('.am-ul-wrapper');
  const body = document.body;

  toggle?.addEventListener('click', () => {
    navigation?.classList.toggle('am-active');
    toggle.classList.toggle('am-active');
    body.classList.toggle('am-open');
  });

  // Mobile dropdown toggle
  const dropdowns = document.querySelectorAll('.am-dropdown');
  dropdowns.forEach(dropdown => {
    dropdown.addEventListener('click', (e) => {
      if (window.innerWidth < 1024) {
        e.preventDefault();
        dropdown.classList.toggle('am-active');
      }
    });
  });

  // Scroll behavior
  let lastScrollTop = 0;
  window.addEventListener('scroll', () => {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    if (scrollTop > lastScrollTop && scrollTop > 100) {
      body.classList.add('scroll');
    } else {
      body.classList.remove('scroll');
    }
    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
  });
</script>
